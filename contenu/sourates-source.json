    "ar": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",
    "fr": "sauf ceux qui croient et accomplissent les bonnes œuvres, s'enjoignent mutuellement la vérité et s'enjoignent mutuellement l'endurance",
    "tr": "Illa allatheena amanoo waAAamiloo alssalihati watawasaw bialhaqqi watawasaw bialssabri",
    "w": [
     {
      "ar": "إِلَّا",
      "tr": "illā",
      "en": "Except"
     },
     {
      "ar": "ٱلَّذِينَ",
      "tr": "alladhīna",
      "en": "those who"
     },
     {
      "ar": "ءَامَنُواْ",
      "tr": "āmanū",
      "en": "believe"
     },
     {
      "ar": "وَعَمِلُواْ",
      "tr": "waʿamilū",
      "en": "and do"
     },
     {
      "ar": "ٱلصَّـٰلِحَٰتِ",
      "tr": "l-ṣāliḥāti",
      "en": "righteous deeds"
     },
     {
      "ar": "وَتَوَاصَوۡاْ",
      "tr": "watawāṣaw",
      "en": "and enjoin (each other)"
     },
     {
      "ar": "بِٱلۡحَقِّ",
      "tr": "bil-ḥaqi",
      "en": "to the truth"
     },
     {
      "ar": "وَتَوَاصَوۡاْ",
      "tr": "watawāṣaw",
      "en": "and enjoin (each other)"
     },
     {
      "ar": "بِٱلصَّبۡرِ",
      "tr": "bil-ṣabri",
      "en": "to [the] patience"
     }
    ]
   }
  ]
 },
