      "tr": "l-mus'taqīma",
      "en": "the straight"
     }
    ]
   },
   {
    "n": 7,
    "ar": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
    "fr": "le chemin de ceux que Tu as comblés de faveurs, non pas de ceux qui ont encouru Ta colère, ni des égarés",
    "tr": "Sirata allatheena anAAamta AAalayhim ghayri almaghdoobi AAalayhim wala alddalleena",
    "w": [
     {
      "ar": "صِرَٰطَ",
      "tr": "ṣirāṭa",
      "en": "(The) path"
     },
     {
      "ar": "ٱلَّذِينَ",
      "tr": "alladhīna",
      "en": "(of) those"
     },
     {
      "ar": "أَنۡعَمۡتَ",
      "tr": "anʿamta",
      "en": "You have bestowed (Your) Favors"
     },
     {
      "ar": "عَلَيۡهِمۡ",
      "tr": "ʿalayhim",
      "en": "on them"
     },
     {
      "ar": "غَيۡرِ",
      "tr": "ghayri",
      "en": "not (of)"
     },
     {
      "ar": "ٱلۡمَغۡضُوبِ",
      "tr": "l-maghḍūbi",
      "en": "those who earned (Your) wrath"
     },
     {
      "ar": "عَلَيۡهِمۡ",
      "tr": "ʿalayhim",
      "en": "on themselves"
     },
     {
      "ar": "وَلَا",
      "tr": "walā",
      "en": "and not"
     },
     {
      "ar": "ٱلضَّآلِّينَ",
      "tr": "l-ḍālīna",
      "en": "(of) those who go astray"
     }
    ]
   }
  ]
 },
 {
