    "tr": "Alrrahmani alrraheemi",
    "w": [
     {
      "ar": "ٱلرَّحۡمَٰنِ",
      "tr": "al-raḥmāni",
      "en": "The Most Gracious"
     },
     {
      "ar": "ٱلرَّحِيمِ",
