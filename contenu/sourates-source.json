    "tr": "Iyyaka naAAbudu waiyyaka nastaAAeenu",
    "w": [
     {
      "ar": "إِيَّاكَ",
      "tr": "iyyāka",
      "en": "You Alone"
     },
     {
      "ar": "نَعۡبُدُ",
      "tr": "naʿbudu",
